<h2 class="section-title">Panel de Control</h2>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card shadow-sm text-center p-3 h-100">
      <i class="bi bi-file-earmark-text fs-2 text-warning"></i>
      <h3 class="mt-2 mb-0"><%= totalPolizas %></h3>
      <small class="text-muted">Pólizas totales</small>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card shadow-sm text-center p-3 h-100">
      <i class="bi bi-cone-striped fs-2 text-warning"></i>
      <h3 class="mt-2 mb-0"><%= totalObras %></h3>
      <small class="text-muted">Obras en ejecución</small>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card shadow-sm text-center p-3 h-100">
      <i class="bi bi-shield-check fs-2 text-warning"></i>
      <h3 class="mt-2 mb-0"><%= totalAseguradoras %></h3>
      <small class="text-muted">Aseguradoras activas</small> 
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card shadow-sm text-center p-3 h-100 border-danger">
      <i class="bi bi-exclamation-triangle fs-2 text-danger"></i>
      <h3 class="mt-2 mb-0"><%= vencidas %></h3>
      <small class="text-muted">Pólizas vencidas</small>
    </div>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <h5 class="mb-3">Seguimiento de cancelaciones</h5>
    <% if (pendientesCancelacion.length === 0 && posiblesSolapamientos.length === 0) { %>
      <div class="alert alert-success mb-4">No hay cancelaciones pendientes ni solapamientos detectados.</div>
    <% } %>

    <% if (pendientesCancelacion.length > 0) { %>
      <h6>Pendientes de confirmar</h6>
      <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr><th>Obra</th><th>Póliza a cancelar</th><th>Reemplazada por</th><th>Acción</th></tr>
          </thead>
          <tbody>
            <% pendientesCancelacion.forEach(p => { %>
              <tr>
                <td><a href="/obras/<%= p.obraId %>/polizas"><%= p.obra ? p.obra.nombre : '-' %></a></td>
                <td><%= p.tipo %> | <%= p.numero %></td>
                <td><%= p.reemplazadaPor && p.reemplazadaPor.length ? p.reemplazadaPor.map(sucesora => `${sucesora.tipo} (${sucesora.numero})`).join(', ') : '-' %></td>
                <td>
                  <form method="POST" action="/polizas/<%= p.id %>/cancelar" onsubmit="return confirm('¿Confirmás que esta póliza ya fue cancelada?')">
                    <button type="submit" class="btn btn-success btn-sm">Confirmar cancelación</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (posiblesSolapamientos.length > 0) { %>
      <h6>Revisar posibles solapamientos</h6>
      <div class="table-responsive mb-4">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Obra</th><th>Póliza anterior vigente</th><th>Etapa posterior vigente</th><th></th></tr>
          </thead>
          <tbody>
            <% posiblesSolapamientos.forEach(item => { %>
              <tr>
                <td><a href="/obras/<%= item.poliza.obraId %>/polizas"><%= item.poliza.obra ? item.poliza.obra.nombre : '-' %></a></td>
                <td><%= item.poliza.tipo %> | <%= item.poliza.numero %></td>
                <td><%= item.sucesora.tipo %> | <%= item.sucesora.numero %></td>
                <td><a href="/obras/<%= item.poliza.obraId %>/polizas" class="btn btn-outline-secondary btn-sm">Revisar</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <h5 class="mb-3">Pólizas próximas a vencer (30 días)</h5>
    <% if (vencenPronto.length === 0) { %>
      <div class="alert alert-info mb-0">No hay pólizas próximas a vencer.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Número</th>
              <th>Obra</th>
              <th>Aseguradora</th>
              <th>Vencimiento</th>
              <th>Monto</th>
            </tr>
          </thead>
          <tbody>
            <% vencenPronto.forEach(p => { %>
              <tr>
                <td><%= p.numero %></td>
                <td><%= p.obra ? p.obra.nombre : '-' %></td>
                <td><%= p.aseguradora ? p.aseguradora.razonSocial : '-' %></td>
                <td><span class="badge bg-warning text-dark"><%= p.fechaVencimiento %></span></td>
                <td><%= p.monto %> <%= p.moneda %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
