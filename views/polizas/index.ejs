<h2 class="section-title">
  Pólizas
  <span class="badge bg-info ms-2">Total: <%= total %></span>
</h2>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <form method="GET" class="d-flex flex-grow-1" style="max-width: 400px;">
    <input type="text" name="search" class="form-control me-2" placeholder="Buscar por número" value="<%= search %>">
    <button class="btn btn-secondary" type="submit">Buscar</button>
  </form>
  <a href="/polizas/nueva" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nueva Póliza</a>
</div>

<div class="table-responsive">
  <table class="table table-hover table-bordered border-secondary-subtle shadow-sm align-middle">
    <thead class="table-light">
      <tr>
        <th>Número</th>
        <th>Tipo</th>
        <th>Obra</th>
        <th>Aseguradora</th>
        <th>Monto</th>
        <th>Emisión</th>
        <th>Vencimiento</th>
        <th>Estado</th>
        <th>PDF</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% polizas.forEach(p => { %>
        <% const vencida = p.fechaVencimiento && new Date(p.fechaVencimiento) < hoy; %>
        <tr>
          <td><%= p.numero %></td>
          <td><%= p.tipo %></td>
          <td><%= p.obra ? p.obra.nombre : '-' %></td>
          <td><%= p.aseguradora ? p.aseguradora.razonSocial : '-' %></td>
          <td><%= p.monto %> <%= p.moneda %></td>
          <td><%= p.fechaEmision %></td>
          <td><%= p.fechaVencimiento || '-' %></td>
          <td>
            <% if (vencida && p.estado === 'Vigente') { %>
              <span class="badge bg-danger">Vencida</span>
            <% } else { %>
              <span class="badge bg-warning text-dark"><%= p.estado %></span>
            <% } %>
          </td>
          <td>
            <% if (p.archivoPdf) { %>
              <a href="/uploads/polizas/<%= encodeURIComponent(p.archivoPdf.split('/').pop()) %>" target="_blank" class="btn btn-danger btn-sm" title="Ver PDF">
                <i class="bi bi-file-earmark-pdf-fill"></i>
              </a>
            <% } %>
          </td>
          <td>
            <div class="d-flex gap-1">
              <a href="/polizas/<%= p.id %>/editar" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil"></i>
              </a>
              <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#eliminarPoliza<%= p.id %>">
                <i class="bi bi-trash"></i>
              </button>
            </div>

            <div class="modal fade" id="eliminarPoliza<%= p.id %>">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header"><h5>Confirmar Eliminación</h5></div>
                  <div class="modal-body">¿Eliminar la póliza <%= p.numero %>?</div>
                  <div class="modal-footer">
                    <form action="/polizas/<%= p.id %>/eliminar" method="POST">
                      <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                  </div>
                </div>
              </div>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (polizas.length === 0) { %>
        <tr><td colspan="10" class="text-center text-muted">No hay pólizas cargadas.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<nav aria-label="Paginación">
  <ul class="pagination justify-content-center">
    <% for (let num = 1; num <= totalPages; num++) { %>
      <li class="page-item <%= num === page ? 'active' : '' %>">
        <a class="page-link" href="/polizas?page=<%= num %>&search=<%= search %>"><%= num %></a>
      </li>
    <% } %>
  </ul>
</nav>
