<h2 class="section-title"><%= poliza ? 'Editar Póliza' : 'Nueva Póliza' %></h2>

<form method="POST" action="<%= poliza ? '/polizas/' + poliza.id : '/polizas' %>" enctype="multipart/form-data" class="card p-3 shadow-sm">
  <div class="row g-3">
    <div class="col-md-4">
      <label class="form-label">Número de Póliza</label>
      <input type="text" name="numero" class="form-control" value="<%= poliza ? poliza.numero : '' %>" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">Tomador</label>
      <input type="text" name="tomador" class="form-control" value="<%= poliza ? poliza.tomador || '' : '' %>">
    </div>
    <div class="col-md-4">
      <label class="form-label">Tipo</label>
      <select name="tipo" id="tipoPoliza" class="form-select" required>
        <% tiposPoliza.forEach(t => { %>
          <option value="<%= t %>" <%= poliza && poliza.tipo === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Obra</label>
      <select name="obraId" id="obraPoliza" class="form-select" required>
        <option value="">Seleccione...</option>
        <% obras.forEach(o => { %>
          <option value="<%= o.id %>" <%= poliza && poliza.obraId === o.id ? 'selected' : '' %>><%= o.nombre %></option>
        <% }) %>
      </select>
    </div>

    <% if (!poliza) { %>
    <div class="col-md-6" id="reemplazoField" hidden>
      <label class="form-label">¿Qué póliza anterior reemplaza?</label>
      <select name="reemplazaAId" id="reemplazaAId" class="form-select">
        <option value="">No reemplaza otra póliza</option>
        <% candidatas.forEach(c => { %>
          <option value="<%= c.id %>" data-obra-id="<%= c.obraId %>" data-etapa="<%= etapasCadena[c.tipo] %>">
            <%= c.obra ? c.obra.nombre : 'Obra' %> | <%= c.tipo %> | <%= c.numero %>
          </option>
        <% }) %>
      </select>
      <div class="form-text" id="reemplazoSugerencia">Seleccioná una póliza solo si corresponde. La baja real se confirma luego.</div>
    </div>
    <% } %>

    <div class="col-md-4">
      <label class="form-label">Aseguradora</label>
      <select name="aseguradoraId" class="form-select" required>
        <option value="">Seleccione...</option>
        <% aseguradoras.forEach(a => { %>
          <option value="<%= a.id %>" <%= poliza && poliza.aseguradoraId === a.id ? 'selected' : '' %>><%= a.razonSocial %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label">Monto</label>
      <input type="number" step="0.01" name="monto" class="form-control" value="<%= poliza ? poliza.monto : '' %>" required>
    </div>
    <div class="col-md-2">
      <label class="form-label">Moneda</label>
      <select name="moneda" class="form-select">
        <option value="ARS" <%= poliza && poliza.moneda === 'ARS' ? 'selected' : '' %>>ARS</option>
        <option value="USD" <%= poliza && poliza.moneda === 'USD' ? 'selected' : '' %>>USD</option>
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label">Fecha de Emisión</label>
      <input type="date" name="fechaEmision" class="form-control" value="<%= poliza ? poliza.fechaEmision : '' %>" required>
    </div>

    <div class="col-md-3">
      <label class="form-label">Fecha de Vencimiento</label>
      <input type="date" name="fechaVencimiento" class="form-control" value="<%= poliza ? poliza.fechaVencimiento : '' %>">
    </div>

    <% if (poliza) { %>
    <div class="col-md-3">
      <label class="form-label">Estado</label>
      <select name="estado" class="form-select">
        <% ['Vigente', 'Pendiente de cancelación', 'Vencida', 'Cancelada', 'Renovada'].forEach(e => { %>
          <option value="<%= e %>" <%= poliza.estado === e ? 'selected' : '' %>><%= e %></option>
        <% }) %>
      </select>
    </div>
    <% } %>

    <div class="col-md-6">
      <label class="form-label">Archivo PDF</label>
      <input type="file" name="archivoPdf" class="form-control" accept="application/pdf">
    </div>

    <div class="col-12">
      <label class="form-label">Observaciones</label>
      <textarea name="observaciones" class="form-control" rows="2"><%= poliza ? poliza.observaciones : '' %></textarea>
    </div>
  </div>

  <div class="mt-3 d-flex gap-2">
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="/polizas" class="btn btn-secondary">Cancelar</a>
  </div>
</form>
